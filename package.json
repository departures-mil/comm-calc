{
  "name": "comm-calc",
  "productName": "Comm Calc",
  "version": "1.13.2",
  "ccShell": 3,
  "description": "İHA alıcı/verici link bütçesi hesaplayıcı",
  "main": "main.js",
  "author": "departures-mil",
  "license": "MIT",
  "repository": "departures-mil/comm-calc",
  "scripts": {
    "start": "electron .",
    "build:web": "node web/build.mjs",
    "surum": "node tools/surum.js",
    "test": "node web/build.mjs && node --test test/app.test.js test/electron-smoke.test.js",
    "test:electron": "node --test test/electron-smoke.test.js",
    "dist": "node web/build.mjs && electron-builder --win nsis --x64 --publish never",
    "eski-kanal": "node tools/eski-kanal.mjs"
  },
  "build": {
    "appId": "com.departuresmil.commcalc",
    "productName": "Comm Calc",
    "copyright": "departures-mil",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app-main.js",
      "preload.js",
      "package.json",
      "cekirdek/**/*",
      "lib/**/*",
      "src/**/*",
      "assets/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Comm Calc",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "tr_TR",
        "en_US",
        "ar_SA"
      ],
      "language": "1055",
      "artifactName": "CommCalc-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "firebase": "^13.1.0",
    "jszip": "^3.10.1"
  }
}
